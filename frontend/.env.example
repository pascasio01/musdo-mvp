# MUSDO Environment Variables
# Copy this file to .env and fill in your values

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Owner access (required for /owner and /admin routes)
# Use the email address registered in Supabase auth
VITE_OWNER_EMAIL=your_email_here

# SECURITY NOTES:
# - Never use service_role key in frontend
# - VITE_ prefixed vars are exposed to the browser
# - Owner protection is enforced additionally via Supabase RLS
# - Keep .env out of version control
