{
  "name": "MUSVORA — Music Asset Operating System",
  "short_name": "MUSVORA",
  "description": "Vault, verify, and monetize your music as protected, ownable assets. MUSVORA — the Music Asset Operating System.",
  "id": "/?source=pwa",
  "start_url": "/home?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/favicon.svg",          "sizes": "any",     "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/icon-192.png",   "sizes": "192x192", "type": "image/png",     "purpose": "any" },
    { "src": "/icons/icon-512.png",   "sizes": "512x512", "type": "image/png",     "purpose": "any" },
    { "src": "/icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Discover",      "short_name": "Home",   "url": "/home",   "description": "Browse human-verified music" },
    { "name": "Vault",         "short_name": "Vault",  "url": "/vault",  "description": "Open your protected music assets" },
    { "name": "Marketplace",   "short_name": "Market", "url": "/market", "description": "License songs from composers" }
  ],
  "screenshots": []
}
